<?xml version="1.0" encoding="utf-8"?>
<!-- Evolutiva 016: transizione di schermata. Le durate sono quelle di Motion (RAPIDO 180, BASE 400, LENTO 720). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="true"
    android:interpolator="@interpolator/decelera">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="400" />
    <translate android:fromYDelta="3%p" android:toYDelta="0" android:duration="400" />
</set>
